{
  "name": "@lemuria/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt --write \"{src,test}/**/*.{m,}ts\" \"*.{m,}ts\"",
    "nest": "nest",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.{m,}ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --no-file-parallelism",
    "test:e2e": "ADAPTER_URL=\"file:app.db\" vitest run --config ./test/vitest.config.mts",
    "postinstall": "prisma generate --generator client"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-node": "^12.3.2",
    "@nestjs/platform-ws": "^12.3.2",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/websockets": "^12.3.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.0",
    "cache-manager": "^7.2.9",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.0",
    "jiti": "^2.7.0",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.0"
  }
}
